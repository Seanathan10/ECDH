{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ecdh",
	"main": "worker.js",
	"compatibility_date": "2026-06-09",
	"observability": {
		"enabled": true,
	},
	"assets": {
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"],
	},
	"routes": [
		{
			"pattern": "ecdh.byseansingh.com",
			"custom_domain": true,
		},
	],
}
